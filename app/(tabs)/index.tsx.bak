  barCol:      { flex: 1, alignItems: 'center' },
  barHalf:     { flex: 1, width: '100%' },
  zeroLine:    { height: 0.5, width: '100%', backgroundColor: colors.border2, alignItems: 'center', justifyContent: 'center' },
