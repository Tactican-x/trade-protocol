// ── Discipline Progress ───────────────────────────────
function DisciplineProgress({ score, color }: { score: number; color: string }) {
  const segments = 10;
  const filled   = Math.round((score / 100) * segments);
  return (
    <View style={discStyles.container}>
      <Text style={[discStyles.score, { color }]}>{score}%</Text>
      <View style={discStyles.segmentRow}>
        {Array.from({ length: segments }).map((_, i) => (
          <View
            key={i}
            style={[
              discStyles.segment,
              { backgroundColor: i < filled ? color : colors.surface2 },
            ]}
          />
        ))}
      </View>
      <Text style={discStyles.label}>
        {score >= 80 ? 'EXCELLENT' : score >= 60 ? 'GOOD' : score >= 40 ? 'NEEDS WORK' : 'CRITICAL'}
      </Text>
    </View>
  );
}
const discStyles = StyleSheet.create({
  container:  { alignItems: 'center', gap: 8 },
  score:      { fontFamily: font.mono, fontSize: 24, fontWeight: '800', letterSpacing: 0.5 },
  segmentRow: { flexDirection: 'row', gap: 3, width: '100%' },
  segment:    { flex: 1, height: 5, borderRadius: 2 },
  label:      { fontFamily: font.mono, fontSize: 8, color: colors.muted, letterSpacing: 1.5 },
});

// ── P&L Chart ─────────────────────────────────────────────────────────────────
function PnlChart({ trades }: { trades: Trade[] }) {
  const last10   = trades.slice(0, 10).reverse();
  const maxAbs   = Math.max(...last10.map((t) => Math.abs(t.pnl)), 1);
  const totalPnl = last10.reduce((s, t) => s + t.pnl, 0);
  const pnlColor = totalPnl > 0 ? colors.green : totalPnl < 0 ? colors.red : colors.muted;

  if (last10.length === 0) {
    return (
      <View style={chartStyles.card}>
        <View style={chartStyles.header}>
          <View style={chartStyles.headerLeft}>
            <View style={[chartStyles.iconBg, { backgroundColor: colors.green + '18' }]}>
              <Ionicons name="bar-chart" size={14} color={colors.green} />
            </View>
            <Text style={chartStyles.title}>P&L PERFORMANCE</Text>
          </View>
        </View>
        <View style={chartStyles.emptyBox}>
          <Ionicons name="trending-up-outline" size={32} color={colors.muted} />
          <Text style={chartStyles.empty}>No trades yet — your performance will appear here</Text>
        </View>
      </View>
    );
  }

  return (
    <View style={chartStyles.card}>
      <View style={chartStyles.header}>
        <View style={chartStyles.headerLeft}>
          <View style={[chartStyles.iconBg, { backgroundColor: colors.green + '18' }]}>
            <Ionicons name="bar-chart" size={14} color={colors.green} />
          </View>
          <Text style={chartStyles.title}>P&L PERFORMANCE</Text>
        </View>
        <View style={chartStyles.totalBadge}>
          <Text style={[chartStyles.totalText, { color: pnlColor }]}>
            {fmtPnl(totalPnl, true)}
          </Text>
        </View>
      </View>

      <View style={chartStyles.chartArea}>
        {last10.map((t, i) => {
          const barH     = Math.max(4, (Math.abs(t.pnl) / maxAbs) * 70);
          const barColor = t.pnl > 0 ? colors.green : t.pnl < 0 ? colors.red : colors.amber;
          const isZero   = t.pnl === 0;
          return (
            <View key={`${t.id}-${i}`} style={chartStyles.barCol}>
              <View style={chartStyles.barHalf}>
                {t.pnl > 0 && (
                  <View style={{ flex: 1, justifyContent: 'flex-end', alignItems: 'center' }}>
                    <View style={[chartStyles.bar, { height: barH, backgroundColor: barColor }]} />
                  </View>
                )}
              </View>
              <View style={chartStyles.zeroLine}>
                {isZero && <View style={[chartStyles.zeroDot, { backgroundColor: colors.amber }]} />}
              </View>
              <View style={chartStyles.barHalf}>
                {t.pnl < 0 && (
                  <View style={{ flex: 1, justifyContent: 'flex-start', alignItems: 'center' }}>
                    <View style={[chartStyles.bar, { height: barH, backgroundColor: barColor }]} />
                  </View>
                )}
              </View>
              <Text style={chartStyles.barLabel}>{i + 1}</Text>
            </View>
          );
        })}
      </View>

      <View style={chartStyles.legend}>
        <View style={chartStyles.legendItem}>
          <View style={[chartStyles.legendDot, { backgroundColor: colors.green }]} />
          <Text style={chartStyles.legendText}>Profit</Text>
        </View>
        <View style={chartStyles.legendItem}>
          <View style={[chartStyles.legendDot, { backgroundColor: colors.red }]} />
          <Text style={chartStyles.legendText}>Loss</Text>
        </View>
        <Text style={chartStyles.legendRight}>Last {last10.length} · oldest → newest</Text>
      </View>
    </View>
  );
}
const chartStyles = StyleSheet.create({
  card:        { backgroundColor: colors.surface, borderWidth: 0.5, borderColor: colors.border, borderRadius: radius.lg, padding: spacing.md, marginBottom: spacing.md },
  header:      { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: spacing.md },
