// ── Best / Worst Trade ────────────────────────────────────────────────────────
function BestWorstTrades({
  best, worst, onPress,
}: {
  best: Trade | null; worst: Trade | null; onPress: (id: number) => void;
}) {
  if (!best && !worst) return null;

  return (
    <View style={bwStyles.card}>
      <View style={bwStyles.header}>
        <View style={[bwStyles.iconBg, { backgroundColor: colors.purple + '18' }]}>
          <Ionicons name="podium" size={14} color={colors.purple} />
        </View>
        <Text style={bwStyles.title}>BEST & WORST TRADES</Text>
      </View>

      {best && (
        <TouchableOpacity
          onPress={() => { Haptics.selectionAsync(); onPress(best.id); }}
          style={[bwStyles.row, !worst && { borderBottomWidth: 0 }]}
          activeOpacity={0.7}
          accessibilityRole="button"
          accessibilityLabel={`Best trade: ${best.pair} ${best.dir}, profit ${best.pnl.toFixed(2)} dollars`}
        >
          <View style={[bwStyles.badge, { backgroundColor: colors.green + '18', borderColor: colors.green + '55' }]}>
            <Ionicons name="trophy" size={12} color={colors.green} />
          </View>
          <View style={bwStyles.info}>
            <Text style={bwStyles.pair}>{best.pair} {best.dir}</Text>
            <Text style={bwStyles.meta}>{best.dateStr} · {best.strategy}</Text>
          </View>
          <Text style={[bwStyles.pnl, { color: colors.green }]}>{fmtPnl(best.pnl)}</Text>
          <Ionicons name="chevron-forward" size={14} color={colors.muted} />
        </TouchableOpacity>
      )}

      {worst && (
        <TouchableOpacity
          onPress={() => { Haptics.selectionAsync(); onPress(worst.id); }}
          style={[bwStyles.row, bwStyles.lastRow]}
          activeOpacity={0.7}
          accessibilityRole="button"
          accessibilityLabel={`Worst trade: ${worst.pair} ${worst.dir}, loss ${Math.abs(worst.pnl).toFixed(2)} dollars`}
        >
          <View style={[bwStyles.badge, { backgroundColor: colors.red + '18', borderColor: colors.red + '55' }]}>
            <Ionicons name="alert-circle" size={12} color={colors.red} />
          </View>
          <View style={bwStyles.info}>
            <Text style={bwStyles.pair}>{worst.pair} {worst.dir}</Text>
            <Text style={bwStyles.meta}>{worst.dateStr} · {worst.strategy}</Text>
          </View>
          <Text style={[bwStyles.pnl, { color: colors.red }]}>{fmtPnl(worst.pnl)}</Text>
          <Ionicons name="chevron-forward" size={14} color={colors.muted} />
        </TouchableOpacity>
      )}
    </View>
  );
}
const bwStyles = StyleSheet.create({
  card:    { backgroundColor: colors.surface, borderWidth: 0.5, borderColor: colors.border, borderRadius: radius.lg, padding: spacing.md, marginBottom: spacing.md },
  header:  { flexDirection: 'row', alignItems: 'center', gap: 8, marginBottom: spacing.md },
